# ProtoMap self-hosted configuration.
#
# Run ./install.sh to generate a .env file, or copy this file to .env and fill in the values yourself. Keep .env
# private: it contains secrets.

# ----------------------------------------------------------------------------------------------------------------------
# Required
# ----------------------------------------------------------------------------------------------------------------------

# At least 16 characters that create the owner's account in the platform, while the server has no members. Generate
# one with: openssl rand -hex 32
PROTOMAP_SETUP_KEY=

# 32 random bytes in hexadecimal that encrypt the secrets the server stores, such as AI provider API keys. Generate one
# with: openssl rand -hex 32. Back it up with the database: without it, stored API keys cannot be read.
PROTOMAP_SECRET_KEY=

# ----------------------------------------------------------------------------------------------------------------------
# Database (pick one of the two options)
# ----------------------------------------------------------------------------------------------------------------------

# Option 1: the bundled PostgreSQL, which Docker Compose runs (recommended for trying ProtoMap). Change the user,
# password, and database before the first start of any deployment other than a local test; an existing volume keeps
# the credentials it was created with. Use only ASCII letters, numbers, hyphens, periods, underscores, and tildes.
COMPOSE_PROFILES=postgres
POSTGRES_USER=protomap
POSTGRES_PASSWORD=protomap
POSTGRES_DB=protomap
PROTOMAP_DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# Option 2: your own PostgreSQL 18 or newer (recommended for production). Remove the bundled settings above and set
# your provider's connection URL. The first start needs permission to create tables.
#PROTOMAP_DATABASE_URL=postgres://user:password@host:5432/database

# ----------------------------------------------------------------------------------------------------------------------
# Optional
# ----------------------------------------------------------------------------------------------------------------------

# The release of the hounddogai/protomap image to run, such as 1.2.3. The latest release by default.
#PROTOMAP_VERSION=latest

# The published port.
#PROTOMAP_PORT=3300

# Leave unset to publish the port on every interface. Set 127.0.0.1 to accept connections only from the Docker host,
# the computer that runs this stack, such as from a proxy on it that ends TLS.
#PROTOMAP_BIND_ADDRESS=127.0.0.1

# A password of at least eight characters for the job queue dashboard at http://127.0.0.1:8801, where the user is
# "admin". Only the Docker host reaches it; from another computer, forward the port over SSH first:
# ssh -L 8801:127.0.0.1:8801 <Docker host>. Leave unset to turn the dashboard off.
#PROTOMAP_ADMIN_PASSWORD=

# The port the job queue dashboard is published on, on 127.0.0.1 of the Docker host.
#PROTOMAP_DASHBOARD_PORT=8801

# The port the bundled PostgreSQL is published on, on 127.0.0.1 of the Docker host. Docker picks a free port by default;
# find it with: docker compose port postgres 5432
#PROTOMAP_POSTGRES_PORT=5432

# How many megabytes of decompressed artifacts the server and the worker each keep decoded in memory, so queries do not
# decode the whole graph each time. Decoded artifacts take a few times more memory than this. 256 by default.
#PROTOMAP_ARTIFACT_CACHE_MB=256

# Where the worker fetches the catalog of AI models ProtoMap offers, hourly, so the models in the model picker stay
# current without an upgrade. Point it at a copy you control, such as on your network when the server cannot reach the
# internet, or set "off" to keep the catalog this release bundles. https://protomap.ai/model-catalog-v1.json by default.
#PROTOMAP_MODEL_CATALOG_URL=https://protomap.ai/model-catalog-v1.json
