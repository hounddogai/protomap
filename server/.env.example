# ProtoMap Server configuration.
#
# Run server/scripts/install.sh to generate .env in ~/.protomap/server/<name>, next to the installation's compose.yaml,
# or copy this file to .env next to a compose.yaml and fill in the values yourself. Keep .env private: it contains
# secrets.

# ----------------------------------------------------------------------------------------------------------------------
# Required
# ----------------------------------------------------------------------------------------------------------------------

# The one-time key, at least 16 characters, that setup asks for before it creates the owner's account. Generate one
# with: openssl rand -hex 32
PROTOMAP_SETUP_KEY=

# 32 random bytes in hexadecimal that encrypt the secrets the server stores: AI provider API keys, the SMTP password,
# and single sign-on client secrets. Generate one with: openssl rand -hex 32. Back it up with the database: without it,
# the stored secrets cannot be read, and must be entered again in Settings.
PROTOMAP_SECRET_KEY=

# ----------------------------------------------------------------------------------------------------------------------
# Database (pick one of the two options)
# ----------------------------------------------------------------------------------------------------------------------

# Option 1: the bundled PostgreSQL, which Docker Compose runs (recommended for trying ProtoMap). Change the user,
# password, and database before the first start of any deployment other than a local test; an existing volume keeps
# the credentials it was created with. Use only ASCII letters, numbers, hyphens, periods, underscores, and tildes.
COMPOSE_PROFILES=postgres
POSTGRES_USER=protomap
POSTGRES_PASSWORD=protomap
POSTGRES_DB=protomap
PROTOMAP_DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# Option 2: your own PostgreSQL 18 or newer (recommended for production). Remove the bundled settings above and set
# your provider's connection URL. The first start needs permission to create tables.
#PROTOMAP_DATABASE_URL=postgres://user:password@host:5432/database

# ----------------------------------------------------------------------------------------------------------------------
# Optional
# ----------------------------------------------------------------------------------------------------------------------

# A personal API key that setup gives the owner it creates, for the CLI on the computer that runs a trial installation:
# its ID, a UUID, and the SHA-256 of the key in hexadecimal. install.sh sets both and writes the key itself to the CLI's
# login, ~/.protomap/login.json. Set both or neither.
#PROTOMAP_INITIAL_API_KEY_ID=
#PROTOMAP_INITIAL_API_KEY_HASH=

# Not a setting of the server: the backup of the CLI login that install.sh replaced with this installation's, which
# uninstall.sh puts back.
#PROTOMAP_CLI_LOGIN_BACKUP=

# The release of the hounddogai/protomap image to run, such as 1.2.3. The latest release by default.
#PROTOMAP_VERSION=latest

# The published port. A CLI logged in at the old port stays pointed there, so after changing the port, log in again
# with protomap login --server=http://localhost:<port>.
#PROTOMAP_PORT=3300

# The Docker Compose project, which names the containers and volumes, such as protomap-postgres. Each installation on a
# Docker host needs a name of its own; install.sh refuses one that another installation uses. protomap by default.
#COMPOSE_PROJECT_NAME=protomap

# Leave unset to publish the port on every interface. Set 127.0.0.1 to accept connections only from the Docker host,
# the computer that runs this stack, such as from a proxy on it that ends TLS.
#PROTOMAP_BIND_ADDRESS=127.0.0.1

# The addresses or CIDR ranges, separated by spaces, of proxies in front of the stack whose X-Forwarded-Proto header to
# believe, beyond private networks and the Docker host, which are always trusted. Set it when a proxy that ends TLS
# reaches the stack from a public address, such as a cloud load balancer.
#PROTOMAP_TRUSTED_PROXIES=203.0.113.0/24

# A password of at least eight characters for the job queue dashboard at http://127.0.0.1:8801, or the port
# PROTOMAP_DASHBOARD_PORT names, where the user is "hounddog". Only the Docker host reaches it; from another computer,
# forward the port over SSH first: ssh -L 8801:127.0.0.1:8801 <Docker host>. Leave unset to turn the dashboard off. A
# shorter password turns it off too, with an error in the worker's log.
#PROTOMAP_ADMIN_PASSWORD=

# The port the job queue dashboard is published on, on 127.0.0.1 of the Docker host. 8801 by default.
#PROTOMAP_DASHBOARD_PORT=8801

# The port the bundled PostgreSQL is published on, on 127.0.0.1 of the Docker host. Docker picks a free port by default;
# find it with: docker compose --file ~/.protomap/server/protomap/compose.yaml port postgres 5432
#PROTOMAP_POSTGRES_PORT=5432

# How much memory, in megabytes, the server and the worker each use to cache decoded scans, so queries do not decode
# the whole graph every time. 768 by default.
#PROTOMAP_ARTIFACT_CACHE_MB=768

# How many connections the database pools of the server and the worker each keep open at most. 10 by default. Besides
# its pool, a server holds one connection per chat response it runs and 4 more, and a worker 18 more for its jobs and
# its job queue, so PostgreSQL must accept this plus PROTOMAP_MAX_RESPONSES plus 4 for each server replica, and this
# plus 18 for each worker: 46 and 28 at the defaults. The bundled PostgreSQL accepts 200, enough for two of each at the
# defaults; lower this or PROTOMAP_MAX_RESPONSES before scaling out further.
#PROTOMAP_DATABASE_CONNECTIONS=10

# How many chat responses the server runs at once. 32 by default. Beyond that, a new message gets a reply that the
# server is busy and to try again in a moment.
#PROTOMAP_MAX_RESPONSES=32

# How many seconds the server keeps serving once it is asked to stop, so that a load balancer still sending it requests
# stops first. None by default.
#PROTOMAP_STOP_DELAY_SECONDS=0

# The address people open ProtoMap at, which links in email start with. Setup records the address it ran at, and server
# owners change it in Settings › Server › Address; set this to lock it here instead.
#PROTOMAP_PUBLIC_URL=https://protomap.example.com

# The SMTP server that sends invitations and password resets, and the address the email is from. Server owners can
# set it in Settings › Server › Email instead; set it here to lock it. Use smtps:// for TLS (port 465), smtp:// for
# STARTTLS (587), or smtp://host:25?tls=none for a server on a trusted network. Escape @ and : in the user and password
# as %40 and %3A.
#PROTOMAP_SMTP_URL=smtp://user:password@smtp.example.com:587
#PROTOMAP_SMTP_FROM=ProtoMap <protomap@example.com>

# The header that carries each client's IP address. Besides each account or email, the server limits these per
# address: failed logins, wrong codes (such as for CLI logins and invitations), codes an identity provider refuses,
# pending CLI logins, and requested emails such as password resets. If every client seemed to come from one address,
# one person's failures would lock everyone out, so set this only where clients' real addresses arrive:
# - X-Forwarded-For counts the address that reached the stack, which suits a stack that people reach directly, on a
#   Docker host that keeps clients' addresses, as rootful Docker Engine on Linux does for IPv4. Docker Desktop, rootless
#   Docker, and clients over IPv6 when the stack's Docker network has none reach the stack from one address of Docker's
#   own: leave this unset there.
# - Behind a proxy that ends TLS, set PROTOMAP_BIND_ADDRESS=127.0.0.1 and name the header that proxy sets to the
#   client's address, such as X-Real-IP, or X-Forwarded-For with PROTOMAP_CLIENT_ADDRESS_HOPS=2, or leave this unset.
#PROTOMAP_CLIENT_ADDRESS_HEADER=X-Forwarded-For

# Which address in that header's list is the client's, counting from the end. 1 by default, the last, which suits a
# header that holds one address, or X-Forwarded-For without a proxy in front of the stack: the stack's own proxy appends
# the address that reached it. Set 2 for X-Forwarded-For behind one proxy that appends the client's address, as nginx's
# $proxy_add_x_forwarded_for does, since the stack's proxy then appends that proxy's address, and one more for each
# further proxy that appends. Only with PROTOMAP_CLIENT_ADDRESS_HEADER.
#PROTOMAP_CLIENT_ADDRESS_HOPS=2

# Where the worker fetches the catalog of AI models ProtoMap offers, hourly, so the models in the model picker stay
# current without an upgrade. Point it at a copy you control, such as on your network when the server cannot reach the
# internet, or set "off" to keep the catalog this release bundles. https://hounddog.ai/model-catalog.json by default.
#PROTOMAP_MODEL_CATALOG_URL=https://hounddog.ai/model-catalog.json

# The oldest ProtoMap CLI release the server accepts, such as 1.2.3. The server refuses older CLIs with status 426.
# CLIs that update themselves then update. One whose automatic updates are off needs `protomap update`, and one
# installed for all users needs its install script run again as root or an administrator. Any release by default.
#PROTOMAP_MINIMUM_CLI_VERSION=1.2.3

# Points every organization's connections to an AI provider at a compatible gateway, over any base URL a connection
# names, without the address checks connections' own base URLs get. One for each provider: OPENAI, ANTHROPIC,
# GOOGLE_GEMINI, AWS_BEDROCK, MICROSOFT_FOUNDRY, GOOGLE_AGENT_PLATFORM, and TYPESAFE. Each provider's own address by
# default.
#PROTOMAP_OPENAI_API_BASE=https://gateway.example.com

# Set to "on" to serve the API reference at /api/docs, with the API's OpenAPI document at /api/openapi.json, to anyone
# who reaches the server. Off by default.
#PROTOMAP_API_DOCS=on
